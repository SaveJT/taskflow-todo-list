{
  "info": {
    "_postman_id": "taskflow-todo-api",
    "name": "TaskFlow Todo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "List todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        }
      }
    },
    {
      "name": "Create todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('todoId', pm.response.json().data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test task\",\n  \"description\": \"Created from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get todo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Update todo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman task\",\n  \"description\": \"Updated from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Toggle complete",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "{{todoId}}",
            "complete"
          ]
        }
      }
    },
    {
      "name": "Delete todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "{{todoId}}"
          ]
        }
      }
    }
  ]
}